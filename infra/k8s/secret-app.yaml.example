# Copy to secret-app.yaml and fill real values before apply. Do NOT commit secret-app.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: devops-app-secret
  namespace: devops
type: Opaque
stringData:
  DEVOPS_INTERNAL_TOKEN: "change-me-in-production"
  SPRING_DATASOURCE_PASSWORD: "root"
  DEVOPS_CLICKHOUSE_PASSWORD: ""
  SPRING_DATA_REDIS_PASSWORD: ""
